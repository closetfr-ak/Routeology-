<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dispatch Dashboard</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:18px;
    background:#f4f5f7;
    font-family:-apple-system,BlinkMacSystemFont,sans-serif;
    color:#111;
}

/* HEADER */

.header{
    text-align:center;
    margin-bottom:24px;
}

.logo{
    width:120px;
    height:auto;
    margin-bottom:10px;
}

.title{
    font-size:32px;
    font-weight:800;
    margin:0;
}

.subtitle{
    margin-top:8px;
    color:#ff2d7a;
    font-weight:700;
    letter-spacing:.5px;
}

/* CARDS */

.card{
    background:#fff;
    border-radius:20px;
    padding:18px;
    margin-bottom:18px;
    box-shadow:0 4px 14px rgba(0,0,0,.05);
}

/* SECTION TITLES */

.section-title{
    font-size:22px;
    font-weight:800;
    margin-bottom:18px;
}

/* FORM GRID */

.form-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:14px;
}

@media(min-width:700px){

    .form-grid{
        grid-template-columns:1fr 1fr;
    }
}

.field label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:6px;
    color:#666;
}

input,
select,
textarea{
    width:100%;
    padding:14px;
    border-radius:14px;
    border:1px solid #ddd;
    background:#fafafa;
    font-size:16px;
}

/* BUTTONS */

.button-row{
    display:flex;
    gap:10px;
    margin-top:18px;
    flex-wrap:wrap;
}

button{
    flex:1;
    border:none;
    border-radius:14px;
    padding:14px;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
}

.primary{
    background:#ff2d7a;
    color:white;
}

.secondary{
    background:#ececf1;
    color:#111;
}

/* ROUTE LINK */

.route-link{
    display:block;
    margin-top:14px;
    color:#ff2d7a;
    font-weight:700;
    text-decoration:none;
}

/* DISPATCH BOX */

.dispatch-box{
    background:#fafafa;
    border:1px solid #e5e5e5;
    border-radius:14px;
    padding:14px;
    margin-top:16px;
    white-space:pre-line;
    line-height:1.5;
    min-height:140px;
}

/* SAVED LOADS */

.load-card{
    border:1px solid #ececec;
    border-radius:16px;
    padding:14px;
    margin-top:14px;
    background:#fafafa;
}

.load-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:10px;
}

.driver{
    font-size:18px;
    font-weight:800;
}

.badge{
    background:#e7f7ee;
    color:#1d8f4d;
    padding:6px 12px;
    border-radius:30px;
    font-size:12px;
    font-weight:700;
}

.load-details{
    line-height:1.7;
    color:#444;
    font-size:15px;
}

.load-actions{
    display:flex;
    gap:8px;
    margin-top:14px;
}

.load-actions button{
    flex:1;
}

/* FOOTER */

.footer{
    text-align:center;
    color:#888;
    margin-top:30px;
    font-size:13px;
}

</style>
</head>

<body>

<!-- HEADER -->

<div class="header">

    <img src="logo.png" class="logo">

    <h1 class="title">
    MINI DISPATCH DASHBOARD
    </h1>

    <div class="subtitle">
    DISPATCH. TRACK. DELIVER.
    </div>

</div>

<!-- ADD LOAD -->

<div class="card">

    <div class="section-title">
    Add New Load
    </div>

    <div class="form-grid">

        <div class="field">
            <label>Driver Name</label>
            <input id="driver" placeholder="Driver name">
        </div>

        <div class="field">
            <label>Pickup Location</label>
            <input id="pickup" placeholder="City, State or Address">
        </div>

        <div class="field">
            <label>Pickup Date & Time</label>
            <input id="pickupTime" placeholder="05/20/2026 8:00 AM">
        </div>

        <div class="field">
            <label>Delivery Location</label>
            <input id="delivery" placeholder="City, State or Address">
        </div>

        <div class="field">
            <label>Delivery Date & Time</label>
            <input id="deliveryTime" placeholder="05/21/2026 2:00 PM">
        </div>

        <div class="field">
            <label>Pay Amount</label>
            <input id="pay" type="number" placeholder="2500">
        </div>

        <div class="field">
            <label>Equipment</label>

            <select id="equipment">

                <option>Dry Van</option>
                <option>Reefer</option>
                <option>Flatbed</option>
                <option>Hotshot</option>
                <option>Power Only</option>

            </select>
        </div>

        <div class="field">
            <label>Status</label>

            <select id="status">

                <option>New</option>
                <option>Confirmed</option>
                <option>In Transit</option>
                <option>Delivered</option>

            </select>
        </div>

    </div>

    <div class="button-row">

        <button class="primary"
        onclick="generateLoad()">
        Generate Dispatch
        </button>

        <button class="secondary"
        onclick="copyDispatch()">
        Copy
        </button>

        <button class="secondary"
        onclick="saveLoad()">
        Save Load
        </button>

    </div>

    <a id="routeLink"
    class="route-link"
    target="_blank">
    </a>

    <div id="dispatchBox"
    class="dispatch-box">
    Dispatch summary will appear here.
    </div>

</div>

<!-- SAVED LOADS -->

<div class="card">

    <div class="section-title">
    Saved Loads
    </div>

    <div id="savedLoads"></div>

</div>

<div class="footer">
© 2026 Dispatch Dashboard
</div>

<script>

let currentDispatch = "";

/* ROUTE GENERATOR */

function generateMapsLink(origin, destination){

    return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(origin)}&destination=${encodeURIComponent(destination)}&travelmode=driving`;
}

/* GENERATE DISPATCH */

function generateLoad(){

    const driver =
    document.getElementById("driver").value || "N/A";

    const pickup =
    document.getElementById("pickup").value;

    const pickupTime =
    document.getElementById("pickupTime").value || "N/A";

    const delivery =
    document.getElementById("delivery").value;

    const deliveryTime =
    document.getElementById("deliveryTime").value || "N/A";

    const pay =
    document.getElementById("pay").value || "0";

    const equipment =
    document.getElementById("equipment").value;

    if(!pickup || !delivery){

        alert("Pickup and delivery required.");
        return;
    }

    const route =
    generateMapsLink(pickup, delivery);

    document.getElementById("routeLink").href =
    route;

    document.getElementById("routeLink").innerText =
    "Open Route in Google Maps";

    currentDispatch =
`DRIVER
${driver}

PICKUP
${pickup}
${pickupTime}

DELIVERY
${delivery}
${deliveryTime}

PAY
$${pay}

EQUIPMENT
${equipment}

ROUTE
${route}`;

    document.getElementById("dispatchBox").innerText =
    currentDispatch;
}

/* COPY */

async function copyDispatch(){

    const text =
    document.getElementById("dispatchBox").innerText;

    if(
        !text ||
        text === "Dispatch summary will appear here."
    ){
        alert("Generate dispatch first.");
        return;
    }

    await navigator.clipboard.writeText(text);

    alert("Dispatch copied.");
}

/* SAVE LOAD */

function saveLoad(){

    const dispatchText =
    document.getElementById("dispatchBox").innerText;

    if(
        !dispatchText ||
        dispatchText === "Dispatch summary will appear here."
    ){
        alert("Generate dispatch first.");
        return;
    }

    const loads =
    JSON.parse(localStorage.getItem("dispatchLoads")) || [];

    const load = {

        driver:
        document.getElementById("driver").value,

        pickup:
        document.getElementById("pickup").value,

        delivery:
        document.getElementById("delivery").value,

        pickupTime:
        document.getElementById("pickupTime").value,

        deliveryTime:
        document.getElementById("deliveryTime").value,

        pay:
        document.getElementById("pay").value,

        equipment:
        document.getElementById("equipment").value,

        status:
        document.getElementById("status").value,

        route:
        document.getElementById("routeLink").href,

        dispatch:
        dispatchText
    };

    loads.unshift(load);

    localStorage.setItem(
        "dispatchLoads",
        JSON.stringify(loads)
    );

    renderLoads();

    alert("Load saved.");
}

/* RENDER LOADS */

function renderLoads(){

    const container =
    document.getElementById("savedLoads");

    const loads =
    JSON.parse(localStorage.getItem("dispatchLoads")) || [];

    if(loads.length === 0){

        container.innerHTML =
        `<p>No saved loads yet.</p>`;

        return;
    }

    container.innerHTML = "";

    loads.forEach((load, index) => {

        const div =
        document.createElement("div");

        div.className =
        "load-card";

        div.innerHTML = `

        <div class="load-top">

            <div class="driver">
            ${load.driver}
            </div>

            <div class="badge">
            ${load.status}
            </div>

        </div>

        <div class="load-details">

            <b>Pickup:</b>
            ${load.pickup}
            <br>

            <b>Delivery:</b>
            ${load.delivery}
            <br>

            <b>Pay:</b>
            $${load.pay}
            <br>

            <b>Equipment:</b>
            ${load.equipment}

        </div>

        <div class="load-actions">

            <button class="primary"
            onclick="openRoute(${index})">
            Route
            </button>

            <button class="secondary"
            onclick="copySaved(${index})">
            Copy
            </button>

        </div>
        `;

        container.appendChild(div);
    });
}

/* OPEN ROUTE */

function openRoute(index){

    const loads =
    JSON.parse(localStorage.getItem("dispatchLoads")) || [];

    window.open(loads[index].route, "_blank");
}

/* COPY SAVED */

async function copySaved(index){

    const loads =
    JSON.parse(localStorage.getItem("dispatchLoads")) || [];

    await navigator.clipboard.writeText(
        loads[index].dispatch
    );

    alert("Dispatch copied.");
}

/* INIT */

renderLoads();

</script>

</body>
</html>